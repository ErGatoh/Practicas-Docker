# Copia este fichero como .env y cambia TODOS los valores marcados.
# El fichero .env no se sube nunca al repositorio.

# --- Credenciales (cámbialas) ---------------------------------------------
INFLUX_USUARIO=admin
INFLUX_CLAVE=cambia-esta-clave-8-caracteres-minimo
INFLUX_TOKEN=cambia-este-token-por-uno-largo-y-aleatorio
GRAFANA_USUARIO=admin
GRAFANA_CLAVE=cambia-esta-clave

# --- Puertos en tu equipo (cámbialos solo si están ocupados) -----------------
PUERTO_MQTT=1883
PUERTO_NODERED=1880
PUERTO_INFLUXDB=8086
PUERTO_GRAFANA=3000

# --- Otros -------------------------------------------------------------------
PREFIJO=iot
TZ=Europe/Madrid
